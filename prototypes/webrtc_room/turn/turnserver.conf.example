# coturn 示例。复制到服务器后替换地址和口令，不要把真实口令提交进仓库。
# 信令服务不走这里。这里只中继 WebRTC 媒体/数据，不承载游戏快照。

listening-port=3478
fingerprint
lt-cred-mech
realm=wpg.example
user=wpg:replace-with-a-long-secret

# 公网地址。NAT 后面的 VPS 必须同时写 external-ip，否则 relay candidate 不可达。
# listening-ip=0.0.0.0
# relay-ip=203.0.113.10
# external-ip=203.0.113.10

min-port=49160
max-port=49200
no-multicast-peers
no-cli
no-tls
no-dtls
log-file=stdout
simple-log

# 防火墙需要放行：
# - UDP/TCP 3478
# - UDP 49160-49200

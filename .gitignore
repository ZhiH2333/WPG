# Godot 4.2+（C# 热重载产物）
~*.dll

# Godot 4+ 缓存与编辑器生成目录
.godot/
.nomedia
/android/
# Android Gradle 构建的本地缓存（由 ensure_android_gradle_template 自动生成）
/.gradle-home/

# Godot 3 遗留导入缓存（4.x 已迁到 .godot/）
.import/

# 导出配置：凭据不要入库；export_presets.cfg 要提交
export.cfg
export_credentials.cfg

# 临时文件、CSV 导入生成的二进制翻译
*.tmp
*.translation

# Mono / C#（当前工程是纯 GDScript，预留给以后）
.mono/
data_*/
mono_crash.*.json

# Godot 运行期生成的 user data：某些环境下 user:// 会落到仓库根的 Godot/app_userdata/。
# 日志 / profile.json.tmp 都是运行产物，不是源码，任何情况下都不入库。
/Godot/app_userdata/

# E2E / 测试运行产生的临时输出（result / ready / go / 原始 stdout-stderr / godot 日志）
/e2e_tmp/

# 导出产物（自行放到这些目录，或落在项目根）
/export/
/builds/
/build/
/artifacts/
/logs/
/.tools/
*.apk
*.aab
*.ipa
*.exe
*.dmg
*.app/

# 参考资料（不入库）
/DesignReference/

# 操作系统
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*~

# 编辑器本地文件
.idea/
*.swp
*.swo
*.bak

# 不要忽略：
# - *.uid      Godot 4.4+ 脚本 UID，必须提交
# - *.import   资源导入 sidecar，必须提交
# - export_presets.cfg  4.1+ 不含密钥，CI 导出需要

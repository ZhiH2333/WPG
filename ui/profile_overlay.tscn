[gd_scene format=3]

[ext_resource type="Script" path="res://ui/profile_overlay.gd" id="1_profile"]
[ext_resource type="Theme" path="res://ui/game_theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://ui/icons/avatar.png" id="3_avatar"]

[node name="ProfileOverlay" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = 60.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_profile")

[node name="Dimmer" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0.07, 0.06, 0.05, 0.42)

[node name="Sheet" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Column" type="VBoxContainer" parent="Sheet"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 48.0
offset_top = 36.0
offset_right = -672.0
offset_bottom = -36.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="Sheet/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Sheet/Column/Header"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_type_variation = &"MenuTitle"
theme_override_colors/font_color = Color(0.96, 0.93, 0.88, 1)
theme_override_constants/outline_size = 0
theme_override_font_sizes/font_size = 32
text = "PROFILE"

[node name="RankButton" type="Button" parent="Sheet/Column/Header"]
custom_minimum_size = Vector2(140, 44)
layout_mode = 2
theme_type_variation = &"EmptyButton"
theme_override_font_sizes/font_size = 18
text = "RANKING"

[node name="Avatar" type="TextureRect" parent="Sheet/Column"]
custom_minimum_size = Vector2(96, 96)
layout_mode = 2
size_flags_horizontal = 0
mouse_filter = 2
texture = ExtResource("3_avatar")
expand_mode = 1
stretch_mode = 5

[node name="Name" type="Button" parent="Sheet/Column"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"EmptyButton"
theme_override_colors/font_color = Color(0.96, 0.93, 0.88, 1)
theme_override_font_sizes/font_size = 40
text = "Player"
alignment = 0

[node name="Caption" type="Label" parent="Sheet/Column"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"OfferDesc"
theme_override_colors/font_color = Color(0.62, 0.58, 0.52, 1)
theme_override_constants/outline_size = 0
theme_override_font_sizes/font_size = 15
text = "local profile"

[node name="CharacterTitle" type="Label" parent="Sheet/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.96, 0.93, 0.88, 1)
theme_override_constants/outline_size = 0
theme_override_font_sizes/font_size = 14
text = "CHARACTER"

[node name="Characters" type="HBoxContainer" parent="Sheet/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 24

[node name="Boar" type="Button" parent="Sheet/Column/Characters"]
custom_minimum_size = Vector2(120, 44)
layout_mode = 2
theme_type_variation = &"EmptyButton"
text = "Boar"

[node name="Chicken" type="Button" parent="Sheet/Column/Characters"]
custom_minimum_size = Vector2(120, 44)
layout_mode = 2
theme_type_variation = &"EmptyButton"
text = "Chicken"

[node name="Stats" type="HBoxContainer" parent="Sheet/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 36

[node name="BestLoop" type="Label" parent="Sheet/Column/Stats"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.96, 0.93, 0.88, 1)
theme_override_constants/outline_size = 0
theme_override_font_sizes/font_size = 20
text = "BEST LOOP  0"

[node name="LastLoop" type="Label" parent="Sheet/Column/Stats"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.96, 0.93, 0.88, 1)
theme_override_constants/outline_size = 0
theme_override_font_sizes/font_size = 20
text = "LAST LOOP  0"

[node name="Runs" type="Label" parent="Sheet/Column/Stats"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.96, 0.93, 0.88, 1)
theme_override_constants/outline_size = 0
theme_override_font_sizes/font_size = 20
text = "RUNS  0"

[node name="Facts" type="VBoxContainer" parent="Sheet/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="LastKills" type="Label" parent="Sheet/Column/Facts"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"RunSummaryHint"
theme_override_constants/outline_size = 0
theme_override_font_sizes/font_size = 15
text = "Last kills  0"

[node name="LastGold" type="Label" parent="Sheet/Column/Facts"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"RunSummaryHint"
theme_override_constants/outline_size = 0
theme_override_font_sizes/font_size = 15
text = "Last gold  0"

[node name="OwnedHint" type="Label" parent="Sheet/Column/Facts"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"RunSummaryHint"
theme_override_constants/outline_size = 0
theme_override_font_sizes/font_size = 15
text = "last owned  -"

[node name="RecordsTitle" type="Label" parent="Sheet/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.96, 0.93, 0.88, 1)
theme_override_constants/outline_size = 0
theme_override_font_sizes/font_size = 14
text = "RECORDS"

[node name="Rows" type="VBoxContainer" parent="Sheet/Column"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Back" type="Button" parent="Sheet/Column"]
custom_minimum_size = Vector2(120, 44)
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"EmptyButton"
theme_override_colors/font_color = Color(0.62, 0.58, 0.52, 1)
theme_override_font_sizes/font_size = 18
text = "Back"

[node name="HoverSfx" type="AudioStreamPlayer" parent="."]
bus = &"SFX"

[node name="ClickSfx" type="AudioStreamPlayer" parent="."]
bus = &"SFX"

[node name="BackSfx" type="AudioStreamPlayer" parent="."]
bus = &"SFX"
